{
  "extends": "../../tsconfig.app.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"]
    },
    // TS appends `/jsx-runtime`, which r-html exports as types only. The tags
    // it cannot know about are merged in from `src/jsx-tags.d.ts`.
    "jsxImportSource": "@dineug/r-html",
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["src"]
}
