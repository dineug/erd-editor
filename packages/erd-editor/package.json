{
  "name": "@dineug/erd-editor",
  "version": "3.5.0",
  "description": "Entity-Relationship Diagram Editor",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./engine.js": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    }
  },
  "unpkg": "./dist/erd-editor.umd.js",
  "jsdelivr": "./dist/erd-editor.umd.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "keywords": [
    "vuerd",
    "editor",
    "erd",
    "db",
    "database",
    "diagram",
    "entity",
    "relationship",
    "sql",
    "draw"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dineug/erd-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dineug/erd-editor/issues"
  },
  "homepage": "https://github.com/dineug/erd-editor#readme",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor... --filter !@dineug/erd-editor build && vp dev",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "e2e": "vp run --filter @dineug/erd-editor build && playwright test",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:bench": "vp run --filter @dineug/erd-editor build && playwright test -c playwright.bench.config.ts",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@easylogic/colorpicker": "^1.10.11",
    "@egjs/agent": "^2.4.3",
    "@radix-ui/colors": "^3.0.0",
    "comlink": "^4.4.2",
    "d3-force": "^3.0.0",
    "deepmerge": "^4.3.1",
    "es-toolkit": "^1.50.0",
    "fuse.js": "^7.0.0",
    "graphql": "^17.0.2",
    "highlight-words-core": "^1.2.2",
    "konva": "^10.3.2",
    "lucide": "^1.35.0",
    "luxon": "^3.4.4",
    "nanoid": "^5.1.3",
    "rxjs": "^7.8.1",
    "stylis": "^4.4.0",
    "tinykeys": "^2.1.0"
  },
  "devDependencies": {
    "@dbml/parse": "10.1.1",
    "@dineug/erd-editor-schema": "workspace:*",
    "@dineug/erd-editor-shiki-worker": "workspace:*",
    "@dineug/r-html": "workspace:*",
    "@dineug/schema-sql-parser": "workspace:*",
    "@dineug/vite-plugin-r-html": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/html-vite": "^10.5.8",
    "@types/d3-force": "3.0.9",
    "@types/highlight-words-core": "^1.2.3",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.1",
    "@typescript/typescript6": "6.0.2",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^20.11.2",
    "stats.js": "^0.17.0",
    "storybook": "^10.5.8",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
