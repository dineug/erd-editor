{
  "name": "@dineug/erd-editor",
  "version": "3.3.1",
  "description": "Entity-Relationship Diagram Editor",
  "type": "module",
  "main": "./dist/erd-editor.js",
  "module": "./dist/erd-editor.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/erd-editor.js"
    },
    "./engine.js": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine.js"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vuerd",
    "editor",
    "erd",
    "db",
    "database",
    "diagram",
    "entity",
    "relationship",
    "sql",
    "draw"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dineug/erd-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dineug/erd-editor/issues"
  },
  "homepage": "https://github.com/dineug/erd-editor#readme",
  "author": "SeungHwan-Lee <dineug2@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor... --filter !@dineug/erd-editor build && vp dev --mode lib",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "e2e": "vp run --filter @dineug/erd-editor build && playwright test",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "devDependencies": {
    "@dineug/erd-editor-schema": "workspace:*",
    "@dineug/erd-editor-shiki-worker": "workspace:*",
    "@dineug/r-html": "workspace:*",
    "@dineug/schema-sql-parser": "workspace:*",
    "@dineug/shared": "workspace:*",
    "@dineug/vite-plugin-r-html": "workspace:*",
    "@easylogic/colorpicker": "1.10.11",
    "@egjs/agent": "^2.4.3",
    "@floating-ui/dom": "1.6.3",
    "@fortawesome/free-regular-svg-icons": "6.5.2",
    "@fortawesome/free-solid-svg-icons": "6.5.2",
    "@mdi/js": "7.4.47",
    "@playwright/test": "^1.62.1",
    "@radix-ui/colors": "3.0.0",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/html-vite": "^10.5.8",
    "@types/color": "^3.0.6",
    "@types/d3": "7.4.3",
    "@types/highlight-words-core": "^1.2.3",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "catalog:",
    "color": "^4.2.3",
    "comlink": "4.4.1",
    "d3": "7.9.0",
    "deepmerge": "^4.3.1",
    "es-toolkit": "^1.50.0",
    "framer-motion": "^11.0.28",
    "fuse.js": "^7.0.0",
    "happy-dom": "^20.11.2",
    "highlight-words-core": "^1.2.2",
    "html-to-image": "^1.11.11",
    "luxon": "^3.4.4",
    "rxjs": "^7.8.1",
    "stats.js": "^0.17.0",
    "storybook": "^10.5.8",
    "tinykeys": "^2.1.0",
    "tslib": "^2.8.1",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "catalog:",
    "vite-plus": "catalog:",
    "@typescript/typescript6": "6.0.2"
  }
}
