{
  "name": "@dineug/erd-editor",
  "version": "4.2.0",
  "description": "Entity-Relationship Diagram Editor",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "erd-editor.js": [
        "./dist/erd-editor.d.ts"
      ],
      "erd-viewer.js": [
        "./dist/erd-viewer.d.ts"
      ],
      "engine.js": [
        "./dist/engine/index.d.ts"
      ],
      "peer.js": [
        "./dist/peer/index.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./erd-editor.js": {
      "types": "./dist/erd-editor.d.ts",
      "default": "./dist/erd-editor.js"
    },
    "./erd-viewer.js": {
      "types": "./dist/erd-viewer.d.ts",
      "default": "./dist/erd-viewer.js"
    },
    "./engine.js": {
      "types": "./dist/engine/index.d.ts",
      "default": "./dist/engine/index.js"
    },
    "./peer.js": {
      "types": "./dist/peer/index.d.ts",
      "default": "./dist/peer/index.js"
    }
  },
  "unpkg": "./dist/erd-editor.umd.js",
  "jsdelivr": "./dist/erd-editor.umd.js",
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": [
    "./dist/erd-editor.js",
    "./dist/erd-viewer.js",
    "**/erd-editor.ts",
    "**/erd-viewer.ts",
    "**/workerDomStubs.*",
    "**/elkWorkerRealm.*"
  ],
  "keywords": [
    "vuerd",
    "editor",
    "erd",
    "db",
    "database",
    "diagram",
    "entity",
    "relationship",
    "sql",
    "draw"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dineug/erd-editor.git"
  },
  "bugs": {
    "url": "https://github.com/dineug/erd-editor/issues"
  },
  "homepage": "https://github.com/dineug/erd-editor#readme",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor... --filter !@dineug/erd-editor build && vp dev",
    "dev:storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "e2e": "vp run --filter @dineug/erd-editor build && playwright test",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:bench": "vp run --filter @dineug/erd-editor build && playwright test -c playwright.bench.config.ts",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@chenglou/pretext": "catalog:",
    "@radix-ui/colors": "^3.0.0",
    "@shikijs/langs": "^4.4.3",
    "@shikijs/themes": "^4.4.3",
    "comlink": "catalog:",
    "d3-force": "^3.0.0",
    "elkjs": "^0.12.0",
    "es-hangul": "^2.4.0",
    "es-toolkit": "catalog:",
    "fuse.js": "^7.5.0",
    "graphql": "^17.0.2",
    "konva": "catalog:",
    "lucide": "^1.35.0",
    "rxjs": "^7.8.1",
    "shiki": "^4.4.3",
    "stylis": "catalog:"
  },
  "devDependencies": {
    "@dbml/parse": "10.1.1",
    "@dineug/erd-editor-schema": "workspace:*",
    "@dineug/grid": "workspace:*",
    "@dineug/r-html": "workspace:*",
    "@dineug/r-html-konva": "workspace:*",
    "@dineug/schema-sql-parser": "workspace:*",
    "@dineug/uuid": "workspace:*",
    "@dineug/vite-plugin-r-html": "workspace:*",
    "@playwright/test": "catalog:",
    "@storybook/addon-docs": "^10.5.8",
    "@storybook/addon-links": "^10.5.8",
    "@storybook/html-vite": "^10.5.8",
    "@types/d3-force": "3.0.9",
    "@types/node": "catalog:",
    "@typescript/typescript6": "catalog:",
    "@vitest/browser-playwright": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "mermaid": "11.17.2",
    "stats.js": "^0.17.0",
    "storybook": "^10.5.8",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plugin-dts": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  }
}
