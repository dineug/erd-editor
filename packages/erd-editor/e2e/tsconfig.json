{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["../src/*"]
    },
    "types": ["node"],
    "noEmit": true
  },
  // `src/vite-env.d.ts` comes along because the fixture entry imports `@/index`,
  // which pulls in modules that rely on `vite/client` types, `?worker` imports
  // and the `__APP_VERSION__` define. `src/konva/jsx.d.ts` is the same kind of
  // ambient file: nothing imports it, and the scene modules the fixture reaches
  // declare their `k-*` tags in it.
  "include": [
    "../e2e",
    "../playwright.config.ts",
    "../playwright.bench.config.ts",
    "../src/konva/jsx.d.ts",
    "../src/vite-env.d.ts"
  ]
}
