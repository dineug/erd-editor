{
  "extends": "./tsconfig.json",
  "exclude": [
    "src/**/*.test.{ts,tsx}",
    "src/**/*.test-d.ts",
    "src/**/*.stories.{ts,tsx}",
    "src/__test-utils__/**",
    // A umd entry ships as a script, never as a module a consumer types
    // against, so it gets no declarations.
    "src/umd/**"
  ]
}
