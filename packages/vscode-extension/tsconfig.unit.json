{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The stub lives outside `src`, so `rootDir` has to widen to the package.
    "rootDir": ".",
    "noEmit": true,
    // `tsconfig.json` targets the webpack build (commonjs + node10 resolution),
    // which cannot read the `exports` map of an ESM-only package like vitest.
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "vscode"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "test/mocks"],
  // Overrides the parent's `exclude`, which drops `src/**/*.test.ts` so the
  // webpack build's program does not choke on them. `extends` inherits that key,
  // and inheriting it here would leave this config compiling zero specs — the
  // one place they are typechecked — while still exiting 0. Measured: without
  // this line a deliberate TS2322 in a spec produces no error at all.
  "exclude": []
}
