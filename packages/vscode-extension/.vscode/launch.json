{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Extension",
      "type": "extensionHost",
      "request": "launch",
      // For `extensionHost` this is the VSCode binary to start, not a package
      // manager — `${execPath}` is the running instance. Anything else opens
      // no Extension Development Host at all.
      "runtimeExecutable": "${execPath}",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}"],
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      // The label from tasks.json, not the auto-detected `npm: dev`.
      "preLaunchTask": "dev"
    }
  ]
}
