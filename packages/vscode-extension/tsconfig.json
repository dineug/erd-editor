{
  "compilerOptions": {
    "module": "commonjs",
    // ES2022. Unlike the browser packages this config really emits —
    // `tsconfig.integration.json` extends it to build `out/` — and the host is
    // Node 20.9, which supports ES2022 in full.
    "target": "ES2022",
    "lib": ["ES2022"],
    "outDir": "out",
    "sourceMap": true,
    // `moduleResolution` is deliberately absent. TypeScript 7 removed
    // `node10` (TS5108), and every explicit replacement breaks one of the
    // three configs that extend this one — `node16` alone costs an error here
    // and another in the integration program. The value TypeScript infers from
    // `module: commonjs` satisfies all three.
    "strict": true,
    "rootDir": "src",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["node", "vscode"]
  },
  "include": ["src"],
  // The unit specs are typechecked by `tsconfig.unit.json`, not here. This
  // config is the CommonJS half of the package: `tsconfig.integration.json`
  // extends it to emit `out/`, which the Extension Host loads directly. Both of
  // its constraints reject the specs — the `vscode` stub they import lives
  // outside `rootDir` (TS6059), and `import.meta` is not allowed under
  // commonjs (TS1343). Excluding them removes errors no gate was meant to see.
  "exclude": ["src/**/*.test.ts"]
}
