{
  "name": "@dineug/erd-editor-app",
  "version": "0.1.0",
  "private": true,
  "description": "Entity-Relationship Diagram Editor App",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor --fail-if-no-match build && vp dev",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "vp run --filter @dineug/erd-editor --fail-if-no-match build && { playwright test; r1=$?; playwright test --config e2e/gdrive/playwright.config.ts; r2=$?; [ $r1 -eq 0 ] && [ $r2 -eq 0 ]; }",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json",
    "google-workspace:assets": "playwright test --config e2e/gdrive/assets.config.ts",
    "google-workspace:check": "node google-workspace/check-assets.mjs"
  },
  "dependencies": {
    "@dineug/erd-editor": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@radix-ui/themes": "^3.3.0",
    "@sentry/react": "^10.70.0",
    "@trystero-p2p/mqtt": "0.25.3",
    "@trystero-p2p/nostr": "0.25.3",
    "comlink": "catalog:",
    "core-js": "catalog:",
    "dexie": "^3.2.7",
    "es-toolkit": "catalog:",
    "immer": "^11.1.17",
    "jotai": "^2.20.2",
    "jotai-immer": "^0.4.3",
    "lucide-react": "^1.47.0",
    "luxon": "^3.7.2",
    "nanoid": "^5.1.3",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/luxon": "^3.4.2",
    "@types/node": "catalog:",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.18.3",
    "vite-plus": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.26.0"
  }
}
