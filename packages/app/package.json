{
  "name": "@dineug/erd-editor-app",
  "version": "0.1.0",
  "private": true,
  "description": "Entity-Relationship Diagram Editor App",
  "author": "SeungHwan-Lee <dineug2@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor --filter @dineug/erd-editor-shiki-worker --filter @dineug/shared build && vp dev",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "vp run --filter @dineug/erd-editor --filter @dineug/erd-editor-shiki-worker --filter @dineug/shared build && playwright test",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@dineug/erd-editor": "workspace:*",
    "@dineug/erd-editor-shiki-worker": "workspace:*",
    "@dineug/shared": "workspace:*",
    "@emotion/react": "^11.14.0",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/themes": "^3.3.0",
    "@sentry/react": "^10.70.0",
    "@trystero-p2p/mqtt": "0.25.3",
    "@trystero-p2p/nostr": "0.25.3",
    "base64-arraybuffer": "^1.0.2",
    "comlink": "^4.4.2",
    "dexie": "^3.2.7",
    "es-toolkit": "^1.50.0",
    "immer": "^11.1.17",
    "jotai": "^2.20.2",
    "jotai-immer": "^0.4.3",
    "luxon": "^3.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1",
    "workbox-window": "^7.4.1",
    "core-js": "^3.50.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^20.11.2",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.18.3",
    "vite-plus": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "@vitejs/plugin-legacy": "^8.2.3",
    "terser": "^5.26.0"
  }
}
