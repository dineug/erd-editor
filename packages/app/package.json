{
  "name": "@dineug/erd-editor-app",
  "version": "0.1.0",
  "private": true,
  "description": "Entity-Relationship Diagram Editor App",
  "author": "SeungHwan-Lee <dineug2@gmail.com>",
  "license": "MIT",
  "scripts": {
    "dev": "vp run --filter @dineug/erd-editor --filter @dineug/erd-editor-shiki-worker --filter @dineug/shared build && vp dev",
    "test:dev": "vp test dev",
    "test:coverage": "vp test run --coverage",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "e2e": "vp run --filter @dineug/erd-editor --filter @dineug/erd-editor-shiki-worker --filter @dineug/shared build && playwright test",
    "e2e:dev": "playwright test --ui",
    "e2e:headed": "playwright test --headed",
    "e2e:report": "playwright show-report e2e/.report",
    "e2e:typecheck": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "@dineug/erd-editor": "workspace:*",
    "@dineug/erd-editor-shiki-worker": "workspace:*",
    "@dineug/shared": "workspace:*",
    "@emotion/react": "^11.11.4",
    "@radix-ui/react-icons": "^1.3.0",
    "@radix-ui/themes": "2.0.3",
    "@sentry/react": "^7.110.0",
    "@trystero-p2p/mqtt": "0.25.3",
    "@trystero-p2p/nostr": "0.25.3",
    "base64-arraybuffer": "^1.0.2",
    "comlink": "4.4.1",
    "dexie": "^3.2.7",
    "immer": "^10.0.4",
    "jotai": "^2.8.0",
    "jotai-immer": "^0.3.0",
    "lodash-es": "^4.17.21",
    "luxon": "^3.4.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.22.3",
    "workbox-cacheable-response": "^7.0.0",
    "workbox-core": "^7.0.0",
    "workbox-expiration": "^7.0.0",
    "workbox-precaching": "^7.0.0",
    "workbox-routing": "^7.0.0",
    "workbox-strategies": "^7.0.0",
    "workbox-window": "^7.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/lodash-es": "^4.17.12",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.77",
    "@types/react-dom": "^18.2.25",
    "@vitest/coverage-v8": "catalog:",
    "happy-dom": "^20.11.2",
    "jotai-devtools": "^0.8.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "ws": "^8.18.3",
    "vite-plus": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1"
  }
}
