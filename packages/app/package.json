    "jotai-devtools": "^0.8.0",
    "mini-css-extract-plugin": "^2.8.1",
    "react-refresh": "^0.14.0",
    "style-loader": "^4.0.0",
    "swc-loader": "0.2.6",
    "tsconfig-paths-webpack-plugin": "^4.1.0",
    "typescript": "7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "^5.91.0",
