{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // ES2022, matching what actually ships: Rolldown emits `#private` fields and
    // downlevels them at no `build.target`, so the bundles required Safari 14.1
    // all along while this said ES2020. `build-target.ts` carries the browser
    // versions that spell out the same line.
    "target": "ES2022",
    "useDefineForClassFields": true,
    // `lib` matches `target`, which means the two guard different things at the
    // same generation. `target` is syntax and the bundler transpiles it; `lib`
    // is runtime APIs and it cannot — `.at()` and `Object.hasOwn` now typecheck
    // and reach the browser as-is.
    //
    // ⚠️ That is only safe where something polyfills them. `app` has core-js
    // through `@vitejs/plugin-legacy`, which derives its set from the same
    // browser target. The nine published libraries do not, and cannot: a
    // polyfill they inject would be imposed on every npm consumer. So an ES2022
    // API reaching a library's `dist` is a bill handed to whoever installs it,
    // and no gate here will say so.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  }
}
